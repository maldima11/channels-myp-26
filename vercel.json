{
  "version": 2,
  "builds": [
    {
      "src": "api/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "web/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/app.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "web/admin/$1"
    },
    {
      "src": "/admin",
      "dest": "web/admin/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "web/$1"
    }
  ]
}
